{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src", "vite.config.ts"],
  // TODO sicherung 1.0.1: the module's own test (7685875, line 242) leaves three parameters unused, which
  // noUnusedParameters refuses; vitest still runs it. Out again once the module's test is fixed (einst-fragen/nexmail.md).
  "exclude": ["src/vendor/nexsicherung/sicherung.test.tsx"]
}
